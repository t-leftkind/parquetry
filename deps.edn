;; parquet-floor pulls org.apache.parquet/parquet-hadoop, a Parquet project
;; module (ParquetWriter/ParquetReader and codecs), NOT Apache Hadoop: no
;; hadoop-common or HDFS. See FINDINGS.md for why parquet-floor was chosen.
{:paths ["src"]
 :deps  {org.clojure/clojure                  {:mvn/version "1.12.0"}
         blue.strategic.parquet/parquet-floor {:mvn/version "2.3"}
         com.taoensso/truss                   {:mvn/version "2.5.1"}
         ;; Loaded only by parquetry.malli.
         metosin/malli                        {:mvn/version "0.20.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha        {:mvn/version "1.91.1392"}
                       nubank/matcher-combinators {:mvn/version "3.11.0"}}
         :main-opts   ["-m" "kaocha.runner"]}

  :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.25.0"}}
           :main-opts  ["-m" "noahtheduke.splint"]}}}
